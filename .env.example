# ---------------------------------------------------------------------------
# Base de datos (PostgreSQL — ej. Supabase, Neon o Railway)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://usuario:password@localhost:5432/pisao?schema=public"

# ---------------------------------------------------------------------------
# NextAuth / Auth.js — panel administrativo
# ---------------------------------------------------------------------------
# Genera un valor con: openssl rand -base64 32
AUTH_SECRET="reemplazar-por-un-secreto-generado"
NEXTAUTH_URL="http://localhost:3000"

# Contraseña temporal para el usuario admin creado por prisma/seed.ts
SEED_ADMIN_PASSWORD="cambiar-esta-clave"

# ---------------------------------------------------------------------------
# Pasarela de tarjeta de crédito/débito (proveedor intercambiable)
# Valores soportados: WOMPI | PAYU | EPAYCO
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER="WOMPI"

# Wompi (https://comercios.wompi.co)
WOMPI_PUBLIC_KEY="pub_test_xxxxxxxxxxxxxxxxxxxxxxxx"
WOMPI_PRIVATE_KEY="prv_test_xxxxxxxxxxxxxxxxxxxxxxxx"
WOMPI_EVENTS_SECRET="test_events_xxxxxxxxxxxxxxxxxxxxxxxx"

# PayU Latam (https://developers.payulatam.com)
PAYU_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"
PAYU_MERCHANT_ID="000000"
PAYU_ACCOUNT_ID="000000"

# ePayco (https://dashboard.epayco.co)
EPAYCO_PUBLIC_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"
EPAYCO_PRIVATE_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------------------------
# Gateway de criptomonedas
# ---------------------------------------------------------------------------
CRYPTO_GATEWAY_PROVIDER="PLACEHOLDER" # ej. COINBASE_COMMERCE, BTCPAY, NOWPAYMENTS
CRYPTO_GATEWAY_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"
CRYPTO_GATEWAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# % de descuento aplicado automáticamente al pagar con cripto
CRYPTO_DISCOUNT_PERCENTAGE="5"

# ---------------------------------------------------------------------------
# Pago QR / transferencia bancaria (datos mostrados en el checkout)
# ---------------------------------------------------------------------------
BANK_TRANSFER_BANK_NAME="Banco Placeholder"
BANK_TRANSFER_ACCOUNT_HOLDER="PISÁO Gastrobar S.A.S."
BANK_TRANSFER_ACCOUNT_TYPE="Ahorros"
BANK_TRANSFER_ACCOUNT_NUMBER="000-000000-00"
BANK_TRANSFER_NIT="900.000.000-0"
BANK_TRANSFER_QR_IMAGE_URL="/pagos/qr-placeholder.svg"

# ---------------------------------------------------------------------------
# Subida de comprobantes de pago (bucket externo — Supabase Storage, S3...)
# ---------------------------------------------------------------------------
UPLOADS_BASE_URL="https://placeholder-bucket.example.com"
UPLOADS_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"
UPLOADS_SECRET_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------------------------
# Integraciones
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER="573246015877"
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL="https://www.google.com/maps/embed?pb=PLACEHOLDER"
NEXT_PUBLIC_INSTAGRAM_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
