# ---------------------------------------------------------------------------
# Base de datos PostgreSQL — Render PostgreSQL en producción
# ---------------------------------------------------------------------------
# Producción: usar la Internal Database URL del servicio Render `pisao-gastrobar-db`.
# Desarrollo local: puede apuntar a un PostgreSQL local.
DATABASE_URL="postgresql://usuario:password@localhost:5432/pisao?schema=public"
DB_POOL_MAX="5"
DB_POOL_IDLE_TIMEOUT_MS="10000"
DB_POOL_CONNECTION_TIMEOUT_MS="8000"

# ---------------------------------------------------------------------------
# NextAuth / Auth.js — panel administrativo
# ---------------------------------------------------------------------------
# Genera un valor con: openssl rand -base64 32
AUTH_SECRET="reemplazar-por-un-secreto-generado"
# Producción canónica: https://pisaogastrobar.com
NEXTAUTH_URL="http://localhost:3000"

# Contraseña temporal para el usuario admin creado por prisma/seed.ts
SEED_ADMIN_PASSWORD="cambiar-esta-clave"

# ---------------------------------------------------------------------------
# Federación de clientes CTG One → PISÁO
# ---------------------------------------------------------------------------
# Origen canónico del proveedor de identidad. En producción usar https://ctgone.com
CTG_ONE_ORIGIN="https://ctgone.com"
# Debe ser el mismo secreto aleatorio de alta entropía configurado en CTG One.
# Mínimo 32 caracteres. Nunca debe exponerse como NEXT_PUBLIC_*.
PISAO_FEDERATION_SECRET="reemplazar-por-secreto-compartido-de-alta-entropia"

# ---------------------------------------------------------------------------
# IA comercial / PISÁO Concierge
# ---------------------------------------------------------------------------
# Clave server-side. Nunca exponerla con prefijo NEXT_PUBLIC_.
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
# Modelo económico y de baja latencia para atención comercial.
PISAO_AI_MODEL="gpt-5.6-luna"

# ---------------------------------------------------------------------------
# Feature flags de pagos
# ---------------------------------------------------------------------------
# Septiembre 2026: QR / Bre-B / transferencia y cripto manual están activos.
# Tarjeta/PSE permanece detrás del flag hasta habilitar la pasarela productiva.
CARD_PAYMENTS_ENABLED="false"
NEXT_PUBLIC_CARD_PAYMENTS_ENABLED="false"

# ---------------------------------------------------------------------------
# Pasarela de tarjeta de crédito/débito / PSE (proveedor intercambiable)
# Valores soportados: WOMPI | PAYU | EPAYCO
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER="WOMPI"

# Wompi (https://comercios.wompi.co)
WOMPI_PUBLIC_KEY="pub_test_xxxxxxxxxxxxxxxxxxxxxxxx"
WOMPI_PRIVATE_KEY="prv_test_xxxxxxxxxxxxxxxxxxxxxxxx"
WOMPI_EVENTS_SECRET="test_events_xxxxxxxxxxxxxxxxxxxxxxxx"

# PayU Latam (https://developers.payulatam.com)
PAYU_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"
PAYU_MERCHANT_ID="000000"
PAYU_ACCOUNT_ID="000000"

# ePayco (https://dashboard.epayco.co)
EPAYCO_PUBLIC_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"
EPAYCO_PRIVATE_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------------------------
# Pago manual con criptomonedas
# ---------------------------------------------------------------------------
# Las direcciones y QR públicos están versionados en la aplicación.
# El cliente paga, sube comprobante y el administrador valida el pago.
# Feature flag productivo. El backend queda habilitado salvo que se defina "false".
CRYPTO_PAYMENTS_ENABLED="true"
NEXT_PUBLIC_CRYPTO_PAYMENTS_ENABLED="true"
# % de descuento aplicado automáticamente al pagar con cripto.
CRYPTO_DISCOUNT_PERCENTAGE="5"

# Prevalidación on-chain. Los endpoints tienen valores públicos de respaldo,
# pero en producción conviene fijar RPC propios para mayor disponibilidad.
BSC_RPC_URL=""
ETH_RPC_URL=""
BTC_EXPLORER_API_URL="https://blockstream.info/api"
# Contrato USDT BEP20 esperado en BNB Smart Chain.
USDT_BSC_CONTRACT="0x55d398326f99059ff775485246999027b3197955"
# Umbrales informativos. El pedido conserva aprobación humana.
CRYPTO_BSC_CONFIRMATIONS="2"
CRYPTO_ETH_CONFIRMATIONS="2"
CRYPTO_BTC_CONFIRMATIONS="1"
# Tolerancia máxima de subpago frente al monto cotizado (por volatilidad/comisiones).
CRYPTO_UNDERPAY_TOLERANCE_PERCENT="1"

# V11 — Orquestador de conciliación cripto.
# El secreto protege el endpoint interno invocado por el cron de Render.
CRYPTO_RECONCILIATION_SECRET="reemplazar-por-secreto-de-32-o-mas-caracteres"
CRYPTO_RECONCILIATION_URL="https://pisaogastrobar.com/api/internal/crypto/reconcile"
CRYPTO_RECONCILIATION_BATCH_SIZE="25"
CRYPTO_NOTIFICATION_RETRY_MINUTES="30"

# V12 — seguimiento privado de pedidos.
# Los enlaces usan tokens aleatorios almacenados únicamente como SHA-256.
ORDER_TRACKING_TTL_DAYS="90"

# ---------------------------------------------------------------------------
# Pago vigente: QR / Llave Bre-B / transferencia Bancolombia
# ---------------------------------------------------------------------------
# Estos NEXT_PUBLIC_* son deliberadamente públicos: son los datos que el
# comercio muestra al comprador para recibir el pago.
NEXT_PUBLIC_BANK_TRANSFER_BANK_NAME="Bancolombia"
NEXT_PUBLIC_BANK_TRANSFER_ACCOUNT_HOLDER="Grupo PISÁO Food & Drinks S.A.S."
NEXT_PUBLIC_BANK_TRANSFER_ACCOUNT_TYPE=""
NEXT_PUBLIC_BANK_TRANSFER_ACCOUNT_NUMBER=""
NEXT_PUBLIC_BANK_TRANSFER_NIT=""
NEXT_PUBLIC_BANK_TRANSFER_BREB_KEY_TYPE=""
NEXT_PUBLIC_BANK_TRANSFER_BREB_KEY=""
NEXT_PUBLIC_BANK_TRANSFER_QR_IMAGE_URL="/QR/QRTransferencia.jpeg"

# Número interno que recibe las confirmaciones de pago. Formato E.164 sin '+'.
PAYMENT_ADMIN_WHATSAPP_NUMBER="573186428218"

# Notificación automática opcional. Si no se configura, la web abre WhatsApp
# con el resumen prellenado y el comprobante permanece seguro en el panel admin.
PAYMENT_ADMIN_NOTIFICATION_WEBHOOK_URL=""
PAYMENT_ADMIN_NOTIFICATION_WEBHOOK_SECRET=""

# Integración opcional directa con Meta WhatsApp Cloud API.
# Si está configurada, el backend intenta enviar el comprobante como media.
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_CLOUD_PHONE_NUMBER_ID=""
WHATSAPP_CLOUD_GRAPH_VERSION="v25.0"

# Webhook bidireccional Meta -> PISÁO Concierge.
# Token compartido usado únicamente durante el handshake GET de Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# App Secret de la Meta App. Se usa para validar X-Hub-Signature-256.
# Nunca exponerlo al navegador.
WHATSAPP_META_APP_SECRET=""
# Mantener "false" hasta completar App Secret + token Cloud API + Phone Number ID.
# El handshake GET funciona aunque este flag permanezca desactivado.
WHATSAPP_WEBHOOK_ENABLED="false"

# Los comprobantes se persisten actualmente en Render PostgreSQL (BYTEA).
# No se utiliza el filesystem efímero de Render.

# ---------------------------------------------------------------------------
# Reservas
# ---------------------------------------------------------------------------
RESERVATION_SLOT_MINUTES="30"
# Tiempo durante el cual una reserva ocupa capacidad del calendario.
RESERVATION_DURATION_MINUTES="90"
RESERVATION_MAX_DINERS_PER_SLOT="32"
# Inventario reservable: 8 mesas. El resto de la terraza funciona por llegada.
RESERVATION_TABLE_COUNT="8"
# Reglas físicas fijas del código: cada mesa tiene 4 puestos y se unen como máximo 3.
# La capacidad grupal es 1 mesa=4, 2 mesas=6, 3 mesas=8.
# No definir variables para sobreescribir estas reglas en producción.
RESERVATION_MIN_ADVANCE_MINUTES="60"
RESERVATION_MAX_ADVANCE_DAYS="60"
RESERVATION_CALENDAR_DAYS="30"
# Fechas excepcionales cerradas, separadas por coma. Ej: 2026-12-24,2026-12-31
RESERVATION_CLOSED_DATES=""

# Notificación opcional por webhook (Make/Zapier/backend WhatsApp, etc.)
RESERVATION_NOTIFICATION_WEBHOOK_URL=""
RESERVATION_NOTIFICATION_WEBHOOK_SECRET=""

# Correo opcional vía Resend. Si no se configura, la reserva se guarda igualmente.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
RESERVATION_NOTIFY_EMAIL="cerveceriacartagena@gmail.com"

# ---------------------------------------------------------------------------
# Integraciones
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER="573246015877"
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL="https://www.google.com/maps/embed?pb=PLACEHOLDER"
NEXT_PUBLIC_INSTAGRAM_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# ---------------------------------------------------------------------------
# Kev Governance Bridge V1 — observe-only
# ---------------------------------------------------------------------------
# Endpoint público firmado de kev-web. No otorga autoridad de mutación a Kev.
KEV_GOVERNANCE_BRIDGE_URL="https://kev-web.onrender.com/api/kev/governance/pisao/events"
# Secreto compartido de alta entropía (>=32 caracteres), únicamente server-side.
KEV_GOVERNANCE_BRIDGE_SECRET="reemplazar-por-secreto-compartido-de-alta-entropia"


# ---------------------------------------------------------------------------
# V7 — Cloudflare Edge Security / Turnstile
# ---------------------------------------------------------------------------
# Bloquea escrituras sensibles servidas desde el subdominio directo de Render
# y exige el dominio canónico. Puede activarse antes de confiar en CF-Connecting-IP.
PISAO_ENFORCE_CANONICAL_HOST="false"
PISAO_CANONICAL_HOSTS="pisaogastrobar.com,www.pisaogastrobar.com"

# Prueba de origen fuerte: configura en Cloudflare una regla que inserte
# x-pisao-edge-secret con el mismo secreto y solo después activa el requisito.
# Mantén el secreto únicamente en Cloudflare + Render; nunca en NEXT_PUBLIC_*.
PISAO_REQUIRE_EDGE_SECRET="false"
PISAO_EDGE_SECRET=""

# Actívalo SOLO cuando el origen esté endurecido y el tráfico público pase
# realmente por Cloudflare. El código requiere además PISAO_ENFORCE_CANONICAL_HOST=true.
CLOUDFLARE_TRUST_PROXY="false"
# El site key es público y puede exponerse al navegador.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# El secret es estrictamente server-side.
TURNSTILE_SECRET_KEY=""
# Hostnames válidos separados por coma. Recomendado en producción:
# pisaogastrobar.com,www.pisaogastrobar.com
TURNSTILE_EXPECTED_HOSTNAME=""

# ---------------------------------------------------------------------------
# V7 — Observabilidad / Sentry-compatible transport
# ---------------------------------------------------------------------------
# DSN de ingestión del proyecto Sentry. No se envían request bodies ni
# transcripciones del Concierge; solo errores técnicos saneados y tags.
SENTRY_DSN=""
