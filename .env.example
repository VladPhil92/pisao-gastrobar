# ---------------------------------------------------------------------------
# Base de datos PostgreSQL — Render PostgreSQL en producción
# ---------------------------------------------------------------------------
# Producción: usar la Internal Database URL del servicio Render `pisao-gastrobar-db`.
# Desarrollo local: puede apuntar a un PostgreSQL local.
DATABASE_URL="postgresql://usuario:password@localhost:5432/pisao?schema=public"
DB_POOL_MAX="5"
DB_POOL_IDLE_TIMEOUT_MS="10000"
DB_POOL_CONNECTION_TIMEOUT_MS="8000"

# ---------------------------------------------------------------------------
# NextAuth / Auth.js — panel administrativo
# ---------------------------------------------------------------------------
# Genera un valor con: openssl rand -base64 32
AUTH_SECRET="reemplazar-por-un-secreto-generado"
# Producción canónica: https://pisaogastrobar.com
NEXTAUTH_URL="http://localhost:3000"

# Contraseña temporal para el usuario admin creado por prisma/seed.ts
SEED_ADMIN_PASSWORD="cambiar-esta-clave"

# ---------------------------------------------------------------------------
# Federación de clientes CTG One → PISÁO
# ---------------------------------------------------------------------------
# Origen canónico del proveedor de identidad. En producción usar https://ctgone.com
CTG_ONE_ORIGIN="https://ctgone.com"
# Debe ser el mismo secreto aleatorio de alta entropía configurado en CTG One.
# Mínimo 32 caracteres. Nunca debe exponerse como NEXT_PUBLIC_*.
PISAO_FEDERATION_SECRET="reemplazar-por-secreto-compartido-de-alta-entropia"

# ---------------------------------------------------------------------------
# IA comercial / PISÁO Concierge
# ---------------------------------------------------------------------------
# Clave server-side. Nunca exponerla con prefijo NEXT_PUBLIC_.
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
# Modelo económico y de baja latencia para atención comercial.
PISAO_AI_MODEL="gpt-5.6-luna"

# ---------------------------------------------------------------------------
# Pasarela de tarjeta de crédito/débito (proveedor intercambiable)
# Valores soportados: WOMPI | PAYU | EPAYCO
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER="WOMPI"

# Wompi (https://comercios.wompi.co)
WOMPI_PUBLIC_KEY="pub_test_xxxxxxxxxxxxxxxxxxxxxxxx"
WOMPI_PRIVATE_KEY="prv_test_xxxxxxxxxxxxxxxxxxxxxxxx"
WOMPI_EVENTS_SECRET="test_events_xxxxxxxxxxxxxxxxxxxxxxxx"

# PayU Latam (https://developers.payulatam.com)
PAYU_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"
PAYU_MERCHANT_ID="000000"
PAYU_ACCOUNT_ID="000000"

# ePayco (https://dashboard.epayco.co)
EPAYCO_PUBLIC_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"
EPAYCO_PRIVATE_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------------------------
# Gateway de criptomonedas
# ---------------------------------------------------------------------------
CRYPTO_GATEWAY_PROVIDER="PLACEHOLDER" # ej. COINBASE_COMMERCE, BTCPAY, NOWPAYMENTS
CRYPTO_GATEWAY_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"
CRYPTO_GATEWAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# % de descuento aplicado automáticamente al pagar con cripto
CRYPTO_DISCOUNT_PERCENTAGE="5"

# ---------------------------------------------------------------------------
# Pago QR / transferencia bancaria (datos mostrados en el checkout)
# ---------------------------------------------------------------------------
BANK_TRANSFER_BANK_NAME="Banco Placeholder"
BANK_TRANSFER_ACCOUNT_HOLDER="PISÁO Gastrobar S.A.S."
BANK_TRANSFER_ACCOUNT_TYPE="Ahorros"
BANK_TRANSFER_ACCOUNT_NUMBER="000-000000-00"
BANK_TRANSFER_NIT="900.000.000-0"
BANK_TRANSFER_QR_IMAGE_URL="/pagos/qr-placeholder.svg"

# ---------------------------------------------------------------------------
# Subida de comprobantes de pago (bucket externo)
# ---------------------------------------------------------------------------
UPLOADS_BASE_URL="https://placeholder-bucket.example.com"
UPLOADS_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"
UPLOADS_SECRET_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------------------------
# Reservas
# ---------------------------------------------------------------------------
RESERVATION_SLOT_MINUTES="30"
# Tiempo durante el cual una reserva ocupa capacidad del calendario.
RESERVATION_DURATION_MINUTES="90"
RESERVATION_MAX_DINERS_PER_SLOT="32"
# Inventario reservable: 8 mesas. El resto de la terraza funciona por llegada.
RESERVATION_TABLE_COUNT="8"
# Cada mesa física tiene 4 puestos.
RESERVATION_SEATS_PER_TABLE="4"
# Máximo de mesas que pueden unirse para una sola reserva.
RESERVATION_MAX_COMBINED_TABLES="3"
# Al unir mesas se pierden 2 puestos por cada unión: 1=4, 2=6, 3=8. No se unen 4 o más.
RESERVATION_MIN_ADVANCE_MINUTES="60"
RESERVATION_MAX_ADVANCE_DAYS="60"
RESERVATION_CALENDAR_DAYS="30"
# Fechas excepcionales cerradas, separadas por coma. Ej: 2026-12-24,2026-12-31
RESERVATION_CLOSED_DATES=""

# Notificación opcional por webhook (Make/Zapier/backend WhatsApp, etc.)
RESERVATION_NOTIFICATION_WEBHOOK_URL=""
RESERVATION_NOTIFICATION_WEBHOOK_SECRET=""

# Correo opcional vía Resend. Si no se configura, la reserva se guarda igualmente.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
RESERVATION_NOTIFY_EMAIL="cerveceriacartagena@gmail.com"

# ---------------------------------------------------------------------------
# Integraciones
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER="573246015877"
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL="https://www.google.com/maps/embed?pb=PLACEHOLDER"
NEXT_PUBLIC_INSTAGRAM_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
