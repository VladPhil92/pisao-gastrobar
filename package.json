{
  "name": "pisao-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run images:optimize && npm run verify:render-release",
    "build": "next build",
    "images:optimize": "node scripts/optimize-images.mjs",
    "postbuild": "node scripts/postbuild-standalone.mjs",
    "start": "node scripts/render-bootstrap.mjs",
    "lint": "eslint",
    "format": "prettier --write .",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:reservations": "tsx --test lib/reservas/table-allocation.test.ts lib/reservas/conversation.test.ts",
    "test:concierge": "tsx --test lib/ai/hospitality-brain.test.ts",
    "test:actions": "tsx --test lib/ai/action-runtime.test.ts",
    "test:tools": "tsx --test lib/ai/tool-orchestrator.test.ts",
    "test:native-tools": "tsx --test lib/ai/native-tools.test.ts",
    "test:security": "tsx --test lib/security/rate-limit.test.ts lib/security/edge-origin.test.ts lib/governance/kev-inbound-security.test.ts",
    "test:revenue": "tsx --test lib/analytics/revenue-attribution.test.ts",
    "test:revenue-actions": "tsx --test lib/revenue/revenue-action-core.test.ts",
    "test:revenue-experiments": "tsx --test lib/revenue/revenue-experiment-core.test.ts",
    "test:revenue-policies": "tsx --test lib/revenue/revenue-policy-core.test.ts",
    "test:profit": "tsx --test lib/revenue/profit-core.test.ts lib/revenue/profit-surface.test.ts",
    "test:payments": "tsx --test lib/payments/onchain.test.ts lib/payments/crypto-intent.test.ts lib/payments/crypto-treasury-core.test.ts",
    "test:tracking": "tsx --test lib/orders/tracking.test.ts lib/orders/status.test.ts",
    "test:whatsapp": "tsx --test lib/whatsapp/coexistence.test.ts",
    "test:inventory": "tsx --test lib/inventory/core.test.ts",
    "test:certification": "tsx --test lib/integrations/certification-core.test.ts lib/integrations/public-web-certification-core.test.ts",
    "test:production-smoke": "node scripts/test-production-smoke.mjs",
    "test:ctgone-auth": "node scripts/test-ctgone-admin-sso.mjs",
    "test:whatsapp-config": "node scripts/test-whatsapp-meta-config.mjs",
    "test:whatsapp-activation": "node scripts/test-whatsapp-activation-v4.mjs",
    "test:whatsapp-operations": "node scripts/test-whatsapp-operations-v5.mjs",
    "test:whatsapp-meta-onboarding": "node scripts/test-whatsapp-meta-onboarding-v6.mjs",
    "test:meta-compliance": "node scripts/test-meta-compliance-v7.mjs",
    "test:meta-app-review": "node scripts/test-meta-app-review-v8.mjs",
    "test:meta-review-evidence": "node scripts/test-meta-review-evidence-v9.mjs",
    "test:owner-governance": "node scripts/test-owner-governance-v10.mjs",
    "test:crm-loyalty": "node scripts/test-customer-crm-loyalty-v11.mjs",
    "verify:release-integrity": "node scripts/verify-release-integrity.mjs",
    "verify:release": "npm run verify:release-integrity && npm run lint && npx tsc --noEmit && npx prisma validate && npm run test:security && npm run test:payments && npm run test:tracking && npm run test:commercial-e2e && npm run test:certification && npm run test:ctgone-auth && npm run test:crm-loyalty",
    "verify:render-release": "npm run verify:release-integrity && npx prisma validate && npm run test:security && npm run test:payments && npm run test:tracking && npm run test:commercial-e2e && npm run test:certification && npm run test:ctgone-auth && npm run test:crm-loyalty",
    "test:commercial-e2e": "tsx --test lib/commercial/e2e-certification.test.ts && node scripts/test-commercial-e2e-v15.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "baseline-browser-mapping": "2.11.0",
    "deepmerge-ts": "8.0.0",
    "fast-uri": "3.1.6",
    "hono": "4.13.5",
    "mysql2": "3.23.1",
    "nanoid": "3.3.18",
    "valibot": "1.4.2"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.1": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  }
}
