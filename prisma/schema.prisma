// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RolUsuario {
  SUPER_ADMIN
  ADMIN
  CAJERO
  COCINA
}

enum TipoEntrega {
  DOMICILIO
  RECOGIDA
}

enum EstadoPedido {
  PENDIENTE_PAGO
  PENDIENTE_VERIFICACION
  CONFIRMADO
  EN_PREPARACION
  LISTO
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum MetodoPago {
  QR_TRANSFERENCIA
  CRIPTO
  TARJETA
}

enum EstadoPago {
  PENDIENTE
  EN_VERIFICACION
  APROBADO
  RECHAZADO
}

enum ProveedorTarjeta {
  WOMPI
  PAYU
  EPAYCO
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

enum UnidadInsumo {
  GRAMO
  MILILITRO
  UNIDAD
}

enum TipoMovimientoInventario {
  CONTEO
  ENTRADA
  SALIDA
  MERMA
  AJUSTE
}

// ---------------------------------------------------------------------------
// Modelos
// ---------------------------------------------------------------------------

/// Usuarios del panel administrativo (no clientes finales).
model Usuario {
  id           String     @id @default(cuid())
  nombre       String
  email        String     @unique
  passwordHash String
  rol          RolUsuario @default(CAJERO)
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  pagosVerificados       Pago[]          @relation("PagoVerificadoPor")
  revenueActionsDecided  RevenueAction[] @relation("RevenueActionDecidedBy")
  revenueActionsExecuted RevenueAction[] @relation("RevenueActionExecutedBy")
  revenueExperimentsStarted RevenueExperiment[] @relation("RevenueExperimentStartedBy")
  revenueExperimentsEnded   RevenueExperiment[] @relation("RevenueExperimentEndedBy")
  revenuePoliciesActivated  RevenuePolicy[] @relation("RevenuePolicyActivatedBy")
  revenuePoliciesRolledBack RevenuePolicy[] @relation("RevenuePolicyRolledBackBy")
  movimientosInventario     MovimientoInventario[]

  @@map("usuarios")
}


/// Perfil de cliente final de PISÁO. Separado de Usuario para evitar que
/// una cuenta comercial pueda adquirir permisos de backoffice.
model Cliente {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String
  telefono     String?
  activo       Boolean  @default(true)
  emailVerified Boolean @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([activo, createdAt])
  @@map("clientes")
}

model Categoria {
  id          String  @id @default(cuid())
  nombre      String
  slug        String  @unique
  descripcion String?
  orden       Int     @default(0)
  activa      Boolean @default(true)

  productos Producto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categorias")
}

model Producto {
  id          String  @id @default(cuid())
  nombre      String
  slug        String  @unique
  descripcion String
  precio          Decimal  @db.Decimal(10, 2)
  costoUnitario   Decimal? @db.Decimal(10, 2)
  imagenUrl       String?
  disponible            Boolean  @default(true)
  inventarioBajo        Boolean  @default(false)
  inventarioBajoReceta  Boolean  @default(false)
  destacado             Boolean  @default(false)
  orden           Int      @default(0)
  costoActualizadoAt DateTime?

  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  itemsPedido    ItemPedido[]
  recetaInsumos  RecetaInsumo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoriaId])
  @@index([disponible, inventarioBajo])
  @@map("productos")
}

/// Insumo operativo almacenado en una unidad base simple para evitar conversiones
/// ambiguas dentro de las recetas. GRAMO, MILILITRO o UNIDAD.
model InventarioInsumo {
  id                     String        @id @default(cuid())
  nombre                 String        @unique
  unidadBase             UnidadInsumo
  stockActual            Decimal       @default(0) @db.Decimal(14, 3)
  stockMinimo            Decimal       @default(0) @db.Decimal(14, 3)
  costoUnidadBase        Decimal?      @db.Decimal(14, 4)
  costoCompraReferencia  Decimal?      @db.Decimal(12, 2)
  cantidadCompraReferencia Decimal?    @db.Decimal(14, 3)
  activo                 Boolean       @default(true)
  ultimaRevisionAt       DateTime?

  recetas      RecetaInsumo[]
  movimientos MovimientoInventario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activo, nombre])
  @@map("inventario_insumos")
}

/// Consumo teórico de un insumo para producir una unidad vendible del producto.
/// No descuenta stock automáticamente; alimenta costo, riesgo y pronóstico.
model RecetaInsumo {
  id           String   @id @default(cuid())
  productoId   String
  producto     Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  insumoId     String
  insumo       InventarioInsumo @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  cantidadBase Decimal  @db.Decimal(14, 3)
  mermaPct     Decimal  @default(0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productoId, insumoId])
  @@index([insumoId, productoId])
  @@map("recetas_insumos")
}

/// Ledger auditable de cambios reales de stock. Cada movimiento conserva
/// stock anterior/posterior y el usuario que ejecutó el cambio.
model MovimientoInventario {
  id            String                   @id @default(cuid())
  insumoId      String
  insumo        InventarioInsumo         @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  tipo          TipoMovimientoInventario
  delta         Decimal                  @db.Decimal(14, 3)
  stockAnterior Decimal                  @db.Decimal(14, 3)
  stockPosterior Decimal                 @db.Decimal(14, 3)
  motivo        String?                  @db.VarChar(180)
  usuarioId     String
  usuario       Usuario                  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  createdAt     DateTime                 @default(now())

  @@index([insumoId, createdAt])
  @@index([tipo, createdAt])
  @@map("movimientos_inventario")
}

model Pedido {
  id     String @id @default(cuid())
  numero Int    @unique @default(autoincrement())

  clienteNombre   String
  clienteTelefono String
  clienteEmail    String?

  tipoEntrega      TipoEntrega
  direccionEntrega String?
  notas            String?

  items ItemPedido[]

  subtotal  Decimal @db.Decimal(10, 2)
  descuento Decimal @default(0) @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  estado      EstadoPedido @default(PENDIENTE_PAGO)
  entregadoAt DateTime?

  pago          Pago?
  attribution   RevenueAttribution?
  seguimientos  PedidoSeguimiento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado, entregadoAt])
  @@map("pedidos")
}

/// Acceso privado para seguimiento de pedidos desde dispositivos del cliente.
/// El token nunca se almacena en claro; únicamente se persiste su hash SHA-256.
model PedidoSeguimiento {
  id           String    @id @default(cuid())
  tokenHash    String    @unique @db.VarChar(64)
  pedidoId     String
  pedido       Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  lastAccessAt DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([pedidoId, createdAt])
  @@index([expiresAt])
  @@map("pedidos_seguimiento")
}

model ItemPedido {
  id       String @id @default(cuid())
  cantidad Int

  precioUnitario       Decimal  @db.Decimal(10, 2)
  costoUnitarioSnapshot Decimal? @db.Decimal(10, 2)
  subtotal              Decimal  @db.Decimal(10, 2)

  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])

  @@index([pedidoId])
  @@map("items_pedido")
}

/// Registro de pago asociado 1:1 a un pedido. Los campos son opcionales
/// porque varían según el método (QR/transferencia, cripto o tarjeta).
model Pago {
  id     String     @id @default(cuid())
  metodo MetodoPago
  estado EstadoPago @default(PENDIENTE)

  monto  Decimal @db.Decimal(10, 2)
  moneda String  @default("COP")

  // Método QR / transferencia bancaria
  // La evidencia se guarda temporalmente en PostgreSQL para no depender del
  // filesystem efímero de Render. El panel sirve el archivo solo a staff autenticado.
  comprobanteUrl        String?
  comprobanteNombre     String?   @db.VarChar(180)
  comprobanteMime       String?   @db.VarChar(96)
  comprobanteBytes      Bytes?
  comprobanteSha256     String?   @db.VarChar(64)
  comprobanteRecibidoEn DateTime?

  // Método criptomonedas
  criptoMoneda          String? // ej. USDT, BTC, ETH
  walletDireccion       String?
  txHash                String? @unique // hash de la transacción on-chain; no reutilizable entre pedidos
  descuentoAplicadoPct  Decimal? @db.Decimal(5, 2) // % de descuento configurable aplicado
  confirmacionesOnchain Int?

  // Método tarjeta (pasarela colombiana, proveedor intercambiable)
  proveedorTarjeta    ProveedorTarjeta?
  linkPago            String?
  referenciaProveedor String? // id/reference que devuelve el proveedor
  payloadProveedor    Json? // respuesta cruda del proveedor (webhook/consulta)

  verificadoPorId String?
  verificadoPor   Usuario?  @relation("PagoVerificadoPor", fields: [verificadoPorId], references: [id])
  verificadoEn    DateTime?

  pedidoId String @unique
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pagos")
}

model Reserva {
  id String @id @default(cuid())

  nombre   String
  telefono String
  email    String?

  fecha    DateTime
  hora     String
  personas Int

  notas  String?
  mesas  String[]      @default([])
  estado EstadoReserva @default(PENDIENTE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fecha])
  @@map("reservas")
}

model MesaReservable {
  id         String   @id @default(cuid())
  codigo     String   @unique
  nombre     String
  capacidad  Int      @default(4)
  zona       String   @default("Terraza reservable")
  prioridad  Int      @default(100)
  combinable Boolean  @default(true)
  activa     Boolean  @default(true)
  atributos  String[] @default([])
  posX       Int      @default(0)
  posY       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activa, prioridad])
  @@map("mesas_reservables")
}

model Evento {
  id String @id @default(cuid())

  titulo      String
  slug        String  @unique
  descripcion String
  imagenUrl   String?

  fecha      DateTime
  horaInicio String
  horaFin    String?
  ubicacion  String   @default("Terraza Panorámica, C.C. Mall Plaza Cartagena")
  cupo       Int?
  activo     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("eventos")
}

/// Telemetría first-party sin PII. sessionId es efímero por pestaña y no
/// identifica a una persona entre sesiones. No se admiten campos de texto libre.
/// Atribución first-party de la sesión que originó un pedido.
/// Se resuelve exclusivamente en servidor a partir de EventoAnalitico; el
/// navegador solo aporta el sessionId efímero. "assists" describe señales
/// observadas y no implica causalidad comercial.
/// Acción comercial propuesta por Revenue Action Engine.
/// Toda acción sensible requiere aprobación humana. Algunas acciones LOW_RISK
/// pueden ejecutarse por el sistema solo después de esa aprobación.
model RevenueAction {
  id              String   @id @default(cuid())
  fingerprint     String   @unique @db.VarChar(64)
  engineVersion   String   @default("revenue_action_engine_v2") @db.VarChar(48)
  type            String   @db.VarChar(48)
  status          String   @default("PENDING") @db.VarChar(24)
  riskLevel       String   @db.VarChar(16)
  executionMode   String   @db.VarChar(24)
  priorityScore   Int      @default(50)

  title             String @db.VarChar(180)
  rationale         String
  recommendedAction String
  objectiveMetric   String @db.VarChar(96)

  evidence Json
  payload  Json?

  decidedById String?
  decidedBy   Usuario? @relation("RevenueActionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  approvedAt  DateTime?
  rejectedAt  DateTime?

  executedById String?
  executedBy   Usuario? @relation("RevenueActionExecutedBy", fields: [executedById], references: [id], onDelete: SetNull)
  executedAt   DateTime?

  measurementStartedAt DateTime?
  measurementWindowDays Int      @default(7)
  measuredAt            DateTime?
  outcome               Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, priorityScore, createdAt])
  experiments RevenueExperiment[]
  policies     RevenuePolicy[]

  @@index([type, createdAt])
  @@map("revenue_actions")
}

/// Experimento controlado derivado de una acción comercial ya aprobada y ejecutada.
/// La unidad experimental es una sessionId first-party efímera; nunca PII.
model RevenueExperiment {
  id               String   @id @default(cuid())
  key              String   @unique @db.VarChar(64)
  actionId         String
  action           RevenueAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  status           String   @default("DRAFT") @db.VarChar(16)
  surface          String   @default("CONCIERGE") @db.VarChar(32)
  primaryMetric    String   @default("paid_conversion_rate") @db.VarChar(64)
  treatmentPct     Int      @default(50)
  minAssignmentsPerArm Int  @default(30)

  startedById String?
  startedBy   Usuario? @relation("RevenueExperimentStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  endedById   String?
  endedBy     Usuario? @relation("RevenueExperimentEndedBy", fields: [endedById], references: [id], onDelete: SetNull)

  startedAt DateTime?
  endedAt   DateTime?
  measuredAt DateTime?
  result    Json?

  assignments RevenueExperimentAssignment[]
  policies    RevenuePolicy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startedAt])
  @@index([actionId, createdAt])
  @@map("revenue_experiments")
}

/// Asignación determinística por sesión para análisis intention-to-treat.
model RevenueExperimentAssignment {
  id           String   @id @default(cuid())
  experimentId String
  experiment   RevenueExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  sessionId    String   @db.VarChar(64)
  arm          String   @db.VarChar(16)
  assignedAt       DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  eligibleAt       DateTime?
  eligibilityCount Int      @default(0)
  exposedAt        DateTime?
  exposureCount    Int      @default(0)

  @@unique([experimentId, sessionId])
  @@index([experimentId, arm, assignedAt])
  @@index([sessionId, assignedAt])
  @@map("revenue_experiment_assignments")
}

/// Política adaptativa promovida exclusivamente desde un experimento controlado
/// concluido con evidencia favorable. Nunca puede modificar precio, descuento,
/// inventario, disponibilidad ni pagos.
model RevenuePolicy {
  id            String @id @default(cuid())
  key           String @unique @db.VarChar(64)
  engineVersion String @default("profit_aware_revenue_v5") @db.VarChar(48)
  status        String @default("DRAFT") @db.VarChar(24)
  surface       String @default("CONCIERGE") @db.VarChar(32)

  actionId String
  action   RevenueAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  experimentId String @unique
  experiment   RevenueExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  trafficPct               Int @default(90)
  priorityScore            Int @default(50)
  minServeAssignments      Int @default(40)
  minHoldoutAssignments    Int @default(20)
  rollbackMarginPctPoints  Int @default(2)

  activatedById String?
  activatedBy   Usuario? @relation("RevenuePolicyActivatedBy", fields: [activatedById], references: [id], onDelete: SetNull)
  rolledBackById String?
  rolledBackBy   Usuario? @relation("RevenuePolicyRolledBackBy", fields: [rolledBackById], references: [id], onDelete: SetNull)

  activatedAt DateTime?
  pausedAt DateTime?
  rolledBackAt DateTime?
  lastMeasuredAt DateTime?
  lastGuardrailCheckAt DateTime?
  rollbackReason         String? @db.VarChar(180)
  operationalPauseReason String? @db.VarChar(180)
  outcome Json?

  assignments RevenuePolicyAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, priorityScore, createdAt])
  @@index([actionId, createdAt])
  @@map("revenue_policies")
}

/// Asignación estable por sesión first-party para monitoreo continuo de una
/// política adaptativa. HOLDOUT preserva una referencia de seguridad.
model RevenuePolicyAssignment {
  id        String @id @default(cuid())
  policyId  String
  policy    RevenuePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  sessionId String @db.VarChar(64)
  arm       String @db.VarChar(16)

  assignedAt    DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  servedAt      DateTime?
  exposureCount Int @default(0)

  @@unique([policyId, sessionId])
  @@index([policyId, arm, assignedAt])
  @@index([sessionId, assignedAt])
  @@map("revenue_policy_assignments")
}

model RevenueAttribution {
  id         String   @id @default(cuid())
  pedidoId   String   @unique
  sessionId  String   @db.VarChar(64)
  assists    String[] @default([])
  lastAssist String?  @db.VarChar(32)
  touchCount Int      @default(0)

  observedFrom DateTime?
  observedTo   DateTime?

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([lastAssist, createdAt])
  @@map("revenue_attributions")
}

model EventoAnalitico {
  id            String   @id @default(cuid())
  tipo          String   @db.VarChar(48)
  sessionId     String   @db.VarChar(64)
  pathname      String   @db.VarChar(180)
  surface       String?  @db.VarChar(48)
  productSlug   String?  @db.VarChar(96)
  categorySlug  String?  @db.VarChar(96)
  intent        String?  @db.VarChar(32)
  step          String?  @db.VarChar(48)
  paymentMethod String?  @db.VarChar(32)
  deviceClass   String?  @db.VarChar(16)
  budgetTier    Int?
  diners        Int?
  itemCount     Int?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([tipo, createdAt])
  @@index([sessionId, createdAt])
  @@map("eventos_analiticos")
}


/// Perfil de hospitalidad anónimo y persistente.
/// No almacena transcripciones, nombre, teléfono ni correo.
model AiGuestProfile {
  id                    String   @id @default(cuid())
  guestKey              String   @unique @db.VarChar(96)
  interactionCount      Int      @default(0)
  conversationStyle     String?  @db.VarChar(24)
  preferredFoodSignals  String[] @default([])
  preferredDrinkSignals String[] @default([])
  lastIntent            String?  @db.VarChar(32)
  lastGuestState        String?  @db.VarChar(32)
  lastSeenAt            DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  sessions AiConversationSession[]
  runs     AiConciergeRun[]

  @@index([lastSeenAt])
  @@map("ai_guest_profiles")
}

/// Sesión lógica del Concierge. Conserva estado operativo, nunca el transcript.
model AiConversationSession {
  id             String   @id @default(cuid())
  sessionKey     String   @unique @db.VarChar(96)
  guestProfileId String?
  messageCount   Int      @default(0)
  lastAgent      String?  @db.VarChar(32)
  lastIntent     String?  @db.VarChar(32)
  lastOutcome    String?  @db.VarChar(48)
  lastTool       String?  @db.VarChar(48)
  commerceState  Json?
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  guestProfile AiGuestProfile? @relation(fields: [guestProfileId], references: [id], onDelete: SetNull)
  runs         AiConciergeRun[]

  @@index([guestProfileId, lastSeenAt])
  @@map("ai_conversation_sessions")
}

/// Telemetría operacional del Concierge para medir calidad, conversión y fallbacks.
/// No contiene texto libre del usuario.
model AiConciergeRun {
  id                String   @id @default(cuid())
  sessionId         String?
  guestProfileId    String?
  model             String   @db.VarChar(64)
  agent             String   @db.VarChar(32)
  intent            String   @db.VarChar(32)
  outcome           String   @db.VarChar(48)
  fallback          Boolean  @default(false)
  latencyMs         Int
  reservationIntent Boolean  @default(false)
  proposalCreated   Boolean  @default(false)
  createdAt         DateTime @default(now())

  session      AiConversationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  guestProfile AiGuestProfile?        @relation(fields: [guestProfileId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([agent, createdAt])
  @@index([sessionId, createdAt])
  @@map("ai_concierge_runs")
}


/// Comandos transaccionales de corta vida originados por el Concierge.
/// Los tokens de confirmación nunca se almacenan en claro.
model AiTransactionCommand {
  id              String   @id @default(cuid())
  sessionKey      String   @db.VarChar(96)
  type            String   @db.VarChar(48)
  status          String   @default("PENDING") @db.VarChar(24)
  tokenHash       String   @db.VarChar(64)
  idempotencyKey  String   @unique @db.VarChar(64)
  payload         Json
  containsPii     Boolean  @default(false)
  expiresAt       DateTime
  confirmedAt     DateTime?
  executedAt      DateTime?
  failureCode     String?  @db.VarChar(64)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sessionKey, status, createdAt])
  @@index([expiresAt])
  @@map("ai_transaction_commands")
}


/// Conexión WhatsApp Cloud API/Coexistence administrada por PISÁO.
/// El token nunca se guarda en claro: se cifra con AES-256-GCM.
model WhatsAppIntegration {
  id                    String   @id @default(cuid())
  wabaId                String   @unique @db.VarChar(32)
  phoneNumberId         String   @unique @db.VarChar(32)
  displayPhoneNumber    String?  @db.VarChar(32)
  verifiedName          String?  @db.VarChar(128)
  status                String   @default("PENDING") @db.VarChar(32)
  coexistence           Boolean  @default(true)
  accessTokenCiphertext String
  accessTokenIv         String   @db.VarChar(32)
  accessTokenTag        String   @db.VarChar(32)
  lastVerifiedAt        DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  conversations WhatsAppConversation[]

  @@index([status, updatedAt])
  @@map("whatsapp_integrations")
}

/// Estado operacional por conversación sin almacenar el número en claro.
/// customerKey es un HMAC estable derivado del wa_id.
model WhatsAppConversation {
  id                 String   @id @default(cuid())
  conversationKey    String   @unique @db.VarChar(96)
  customerKey        String   @db.VarChar(64)
  integrationId      String?
  phoneNumberId      String?  @db.VarChar(32)
  humanHandoffUntil  DateTime?
  lastHumanMessageAt DateTime?
  lastInboundAt      DateTime?
  lastAiMessageAt    DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  integration WhatsAppIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([customerKey, updatedAt])
  @@index([integrationId, updatedAt])
  @@index([humanHandoffUntil])
  @@map("whatsapp_conversations")
}

/// Idempotencia y telemetría mínima de webhooks.
/// No conserva payloads, texto, contactos ni números de clientes.
model WhatsAppWebhookEvent {
  id            String    @id @default(cuid())
  eventKey      String    @unique @db.VarChar(128)
  field         String    @db.VarChar(48)
  phoneNumberId String?   @db.VarChar(32)
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?

  @@index([field, receivedAt])
  @@map("whatsapp_webhook_events")
}


/// Evidencia técnica sin PII para certificar integraciones de producción.
/// Registra entregas y ejecuciones, nunca mensajes, teléfonos, tokens ni payloads sensibles.
model IntegrationEvidence {
  id          String   @id @default(cuid())
  integration String   @db.VarChar(32)
  event       String   @db.VarChar(64)
  status      String   @db.VarChar(24)
  detail      Json?
  createdAt   DateTime @default(now())

  @@index([integration, status, createdAt])
  @@index([integration, event, createdAt])
  @@index([createdAt])
  @@map("integration_evidence")
}
